<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Shared\TruckingAdvisor.Shared.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Core\TruckingAdvisor.Core.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.AI\TruckingAdvisor.AI.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Telemetry\TruckingAdvisor.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Data\TruckingAdvisor.Data.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Presentation\TruckingAdvisor.Presentation.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.EdgeTts\TruckingAdvisor.EdgeTts.csproj" />
    <ProjectReference Include="..\..\src\TruckingAdvisor.Audio\TruckingAdvisor.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SimHub plugin targets .NET Framework for SimHub; its SimHub-free logic is tested here. -->
    <Compile Include="..\..\src\TruckingAdvisor.SimHubPlugin\TriplePlan.cs" Link="SimHubPlugin\TriplePlan.cs" />
  </ItemGroup>
</Project>
