<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TruckingAdvisor</AssemblyName>
    <Version>3.0.0</Version>
    <Product>TruckingAdvisor</Product>
    <Company>TruckingAdvisor contributors</Company>
    <Description>ATS telemetry dashboard, driving coach and AI CB radio</Description>
    <Copyright>Copyright (c) 2026 TruckingAdvisor contributors. MIT License.</Copyright>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <ApplicationIcon>Assets\TruckingAdvisor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\TruckingAdvisor.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TruckingAdvisor.Shared\TruckingAdvisor.Shared.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.Telemetry\TruckingAdvisor.Telemetry.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.Core\TruckingAdvisor.Core.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.Data\TruckingAdvisor.Data.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.Audio\TruckingAdvisor.Audio.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.AI\TruckingAdvisor.AI.csproj" />
    <ProjectReference Include="..\TruckingAdvisor.Presentation\TruckingAdvisor.Presentation.csproj" />
  </ItemGroup>
</Project>
