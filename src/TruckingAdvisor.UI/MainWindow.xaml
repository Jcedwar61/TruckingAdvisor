<Window x:Class="TruckingAdvisor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TruckingAdvisor — ATS Telemetry, Driving Coach &amp; AI CB Radio"
        Icon="Assets/TruckingAdvisor.ico"
        Width="1380" Height="880" MinWidth="900" MinHeight="600" ResizeMode="CanResize"
        Background="#0B0F17" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#151C28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="Assets/TruckingAdvisor.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="TRUCKINGADVISOR" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" Foreground="#10B981"/>
                        <TextBlock Text="{Binding GameStatusText}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="520"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="BtnAiSettings" Content="AI &amp; Radio Settings" Click="BtnAiSettings_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnPlugin" Content="Install Telemetry Plugin" Click="BtnPlugin_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnDemo" Content="Try Demo Data" Click="BtnDemo_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnToggleOverlay" Content="HUD Overlay (F8)" Click="BtnToggleOverlay_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnHudLock" Content="Move/Resize HUD" Click="BtnHudLock_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnRebindPtt" Content="Rebind PTT Key" Click="BtnRebindPtt_Click" Style="{StaticResource TopButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Demo banner: impossible to miss when values are not from the game -->
        <Border Grid.Row="1" Background="#7C2D12" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDemo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="DEMO MODE — these numbers are generated for testing and are not from American Truck Simulator. Demo trips are never saved." FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="2" Background="#0B0F17" BorderThickness="0" Padding="0,8,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#0B0F17"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>
        <TabItem Header="Dashboard &amp; Radio">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.25*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <!-- Drag to give the dashboard or the radio more room. -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- Left: instruments, trip, coach -->
            <ScrollViewer Grid.Column="0" Margin="0,0,4,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SPEED (MPH)" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding SpeedText}" FontSize="36" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpeeding}" Value="True">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SpeedLimitText}" Foreground="#F59E0B" FontSize="12"/>
                                <TextBlock Text="{Binding CruiseText}" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ENGINE" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding RpmText}" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="{Binding GearText}" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding EngineTempText}" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="FUEL" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding FuelText}" FontSize="26" FontWeight="Bold" Foreground="#F59E0B"/>
                                <TextBlock Text="{Binding RangeText}" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding MpgText}" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="TRIP SCORE" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding ScoreText}" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="{Binding RatingText}" Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AirText}" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ACTIVE DELIVERY" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CargoText}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RouteText}" Foreground="#94A3B8" Margin="0,4,0,4"/>
                            <ProgressBar Value="{Binding TripProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="#10B981" Background="#0B0F17" BorderThickness="0"/>
                            <TextBlock Text="{Binding RemainingText}" Foreground="#10B981" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TripStateText}" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Foreground="#94A3B8" FontSize="12">
                                <Run Text="Game time "/><Run Text="{Binding GameTimeText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding RestText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="COACH, FUEL &amp; MAINTENANCE ADVISORIES" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ActiveAdvisories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="RECENT COACHING EVENTS" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding RecentIncidents}" Height="140" Background="#0B0F17" Foreground="#F8FAFC" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Severity, Mode=OneWay}" Foreground="#F59E0B"/><Run Text=": "/><Run Text="{Binding AdvisoryMessage, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LAST DELIVERY REPORT" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LastReport, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Background="#0B0F17" Foreground="#F8FAFC" BorderThickness="0" MinHeight="60" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: CB radio -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button Content="Next Channel ( ] )" Click="BtnChannel_Click" DockPanel.Dock="Right" Style="{StaticResource TopButton}" Margin="0"/>
                            <TextBlock Text="{Binding RadioChannelText}" Foreground="#F59E0B" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RadioStateText}" Foreground="#10B981" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding PartnerText}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding AiStatusText}" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding RadioNotice}" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel>
                            <Button x:Name="BtnSend" Content="Send" Click="BtnSend_Click" DockPanel.Dock="Right" Style="{StaticResource TopButton}" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtMessage" KeyDown="TxtMessage_KeyDown" Background="#0B0F17" Foreground="#F8FAFC" Padding="6" ToolTip="Type a CB message and press Enter (works without a microphone)"/>
                        </DockPanel>
                        <Button x:Name="BtnHoldPtt" Content="HOLD TO TALK (LEFT ALT)" Margin="0,8,0,0"
                                PreviewMouseLeftButtonDown="BtnHoldPtt_Down" PreviewMouseLeftButtonUp="BtnHoldPtt_Up"
                                Background="#F59E0B" Foreground="#0B0F17" FontWeight="Bold" Padding="16,10"/>
                    </StackPanel>
                    <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding RadioTranscriptLog}" Background="#0B0F17" Foreground="#F8FAFC" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
                </Grid>
        </TabItem>

        <!-- Career: company, levels, achievements, insights, per-truck MPG -->
        <TabItem Header="Career &amp; Company">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VIRTUAL COMPANY" Foreground="#F59E0B" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CompanySummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Only trips recorded by TruckingAdvisor count. Income is the game's job income, not real money." Style="{StaticResource Label}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DRIVER CAREER" Foreground="#F59E0B" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CareerSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="INSIGHTS" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Insights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="FUEL ECONOMY BY TRUCK" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding TruckEconomyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ACHIEVEMENTS &amp; COMPANY MILESTONES" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Achievements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="18"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#10B981">
                                                <Run Text="{Binding ProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- CB contacts (spec 40E) -->
        <TabItem Header="CB Contacts">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LstContacts" ItemsSource="{Binding Contacts}" Background="#0B0F17" Foreground="#F8FAFC" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Handle}" FontWeight="Bold" Foreground="#F59E0B"/>
                                    <TextBlock Style="{StaticResource Label}">
                                        <Run Text="{Binding Relationship, Mode=OneWay}"/><Run Text=" • last contact "/><Run Text="{Binding LastContact, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Conversations, Mode=OneWay}"/><Run Text=" conversations"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding SelectedItem, ElementName=LstContacts}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,2,0,8">
                            <Run Text="{Binding Truck, Mode=OneWay}"/><Run Text=" • from "/><Run Text="{Binding HomeState, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="WHAT THEY REMEMBER" Style="{StaticResource Label}"/>
                        <ItemsControl ItemsSource="{Binding Memories}" Margin="0,4,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Forget our conversations" Click="BtnForgetContact_Click" HorizontalAlignment="Left" Style="{StaticResource TopButton}"/>
                        <TextBlock Text="These are simulated radio characters, not real players or nearby trucks." Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Trip history and exports -->
        <TabItem Header="Trips">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Export all (CSV)" Click="BtnExportCsv_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Export selected (JSON)" Click="BtnExportJson_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Copy selected report" Click="BtnCopyReport_Click" Style="{StaticResource TopButton}"/>
                </StackPanel>
                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LstTrips" Grid.Row="1" ItemsSource="{Binding TripHistory}" Background="#0B0F17" Foreground="#F8FAFC" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,3">
                                <Run Text="{Binding StartedAt, Mode=OneWay, StringFormat=yyyy-MM-dd}"/><Run Text="  "/><Run Text="{Binding Cargo, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Origin, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding Destination, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding DistanceMiles, Mode=OneWay, StringFormat={}{0:F0} mi}"/><Run Text="  •  score "/><Run Text="{Binding ScoreBreakdown.FinalScore, Mode=OneWay}" Foreground="#10B981"/><Run Text="  •  "/><Run Text="{Binding State, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
