<Window x:Class="TruckingAdvisor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TruckingAdvisor.UI.Controls"
        Title="TruckingAdvisor — ATS Telemetry, Driving Coach &amp; AI CB Radio"
        Icon="Assets/TruckingAdvisor.ico"
        Width="1380" Height="880" MinWidth="900" MinHeight="600" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="ChannelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Fill" Value="{DynamicResource ButtonBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="Assets/TruckingAdvisor.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="TRUCKINGADVISOR" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" Foreground="{DynamicResource GoodBrush}"/>
                        <TextBlock Text="{Binding LocationText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding GradeAheadText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BadBrush}"/>
                        <TextBlock Text="{Binding GameStatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="520"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="BtnAiSettings" Content="AI &amp; Radio Settings" Click="BtnAiSettings_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnLayout" Content="Layout &amp; Theme" Click="BtnLayout_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnPlugin" Content="Install Telemetry Plugin" Click="BtnPlugin_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnDemo" Content="Try Demo Data" Click="BtnDemo_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnToggleOverlay" Content="HUD Overlay (F8)" Click="BtnToggleOverlay_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnHudLock" Content="Move/Resize HUD" Click="BtnHudLock_Click" Style="{StaticResource TopButton}"/>
                    <Button x:Name="BtnRebindPtt" Content="Rebind PTT Key" Click="BtnRebindPtt_Click" Style="{StaticResource TopButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Demo banner: impossible to miss when values are not from the game -->
        <Border Grid.Row="1" Background="#7C2D12" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDemo}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="DEMO MODE — these numbers are generated for testing and are not from American Truck Simulator. Demo trips are never saved." FontWeight="Bold"/>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2">
        <TabItem Header="Dashboard &amp; Radio">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.25*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <!-- Drag to give the dashboard or the radio more room. -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- Left: instruments, trip, coach -->
            <ScrollViewer Grid.Column="0" Margin="0,0,4,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DashboardStack">
                    <UniformGrid x:Name="WGauges" Columns="4" Margin="0,0,0,10">
                        <Border x:Name="GSpeed" Style="{StaticResource Card}" Margin="0,0,6,0">
                            <StackPanel>
                                <c:RadialGauge Title="SPEED" Unit="MPH" Maximum="100" MajorStep="20"
                                               Value="{Binding SpeedValue, Mode=OneWay}" Marker="{Binding SpeedLimitValue, Mode=OneWay}"
                                               ValueText="{Binding SpeedText, Mode=OneWay}" IsAlert="{Binding IsSpeeding, Mode=OneWay}"
                                               ValueBrush="{DynamicResource AccentBrush}" AlertBrush="{DynamicResource BadBrush}"
                                               TrackBrush="{DynamicResource ButtonBrush}" TextBrush="{DynamicResource TextBrush}" MutedBrush="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding SpeedLimitText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CruiseText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GEngine" Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <c:RadialGauge Title="ENGINE" Unit="RPM x100" Maximum="{Binding RpmMax, Mode=OneWay}" MajorStep="500" LabelDivisor="100"
                                               Value="{Binding RpmValue, Mode=OneWay}" RedFrom="{Binding RpmRedFrom, Mode=OneWay}"
                                               ValueText="{Binding RpmDialText, Mode=OneWay}"
                                               ValueBrush="{DynamicResource GoodBrush}" AlertBrush="{DynamicResource BadBrush}"
                                               TrackBrush="{DynamicResource ButtonBrush}" TextBrush="{DynamicResource TextBrush}" MutedBrush="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding GearText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EngineTempText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GFuel" Style="{StaticResource Card}" Margin="3,0,3,0">
                            <StackPanel>
                                <c:RadialGauge Title="FUEL" Unit="PERCENT" Maximum="100" MajorStep="25"
                                               Value="{Binding FuelPercentValue, Mode=OneWay}" ValueText="{Binding FuelText, Mode=OneWay}"
                                               IsAlert="{Binding IsFuelLow, Mode=OneWay}"
                                               ValueBrush="{DynamicResource AccentBrush}" AlertBrush="{DynamicResource BadBrush}"
                                               TrackBrush="{DynamicResource ButtonBrush}" TextBrush="{DynamicResource TextBrush}" MutedBrush="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding MpgText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GScore" Style="{StaticResource Card}" Margin="6,0,0,0">
                            <StackPanel>
                                <c:RadialGauge Title="TRIP SCORE" Unit="OUT OF 100" Maximum="100" MajorStep="25"
                                               Value="{Binding ScoreValue, Mode=OneWay}" ValueText="{Binding ScoreDialText, Mode=OneWay}"
                                               ValueBrush="{DynamicResource GoodBrush}" AlertBrush="{DynamicResource BadBrush}"
                                               TrackBrush="{DynamicResource ButtonBrush}" TextBrush="{DynamicResource TextBrush}" MutedBrush="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding RatingText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding AirText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="WDelivery" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ACTIVE DELIVERY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CargoText}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RouteText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,4"/>
                            <ProgressBar Value="{Binding TripProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource GoodBrush}" Background="{DynamicResource BgBrush}" BorderThickness="0"/>
                            <TextBlock Text="{Binding RemainingText}" Foreground="{DynamicResource GoodBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TripStateText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12">
                                <Run Text="Game time "/><Run Text="{Binding GameTimeText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding RestText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="WAdvisories" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="COACH, FUEL &amp; MAINTENANCE ADVISORIES" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ActiveAdvisories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="RECENT COACHING EVENTS" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding RecentIncidents}" Height="140">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Severity, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text=": "/><Run Text="{Binding AdvisoryMessage, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border x:Name="WReport" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="LAST DELIVERY REPORT" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LastReport, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MinHeight="60" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                <Border x:Name="WTrend" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <c:TrendChart Title="DRIVER SCORE TREND" Values="{Binding ScoreTrend}" Height="150"
                                      LineBrush="{DynamicResource GoodBrush}" TextBrush="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: CB radio -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Radio face: LCD with channel, lamps and state -->
                        <Border Background="#05080D" CornerRadius="8" Padding="14,10" BorderBrush="{DynamicResource ButtonBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ChannelNumberText}" FontFamily="Consolas" FontSize="54" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChannelNameText}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="TX" FontFamily="Consolas" Foreground="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource GoodBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="RX" FontFamily="Consolas" Foreground="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRadioBusy}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="BUSY" FontFamily="Consolas" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RadioStateText}" FontFamily="Consolas" FontSize="12" Foreground="#10B981" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="19" Tag="19" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Highway traffic"/>
                            <Button Content="9" Tag="9" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Emergency"/>
                            <Button Content="17" Tag="17" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Regional traffic"/>
                            <Button Content="21" Tag="21" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Casual conversation"/>
                            <Button Content="25" Tag="25" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Truck stop talk"/>
                            <Button Content="30 DISPATCH" Tag="30" Click="BtnChannelPreset_Click" Style="{StaticResource ChannelButton}" ToolTip="Company dispatch"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PartnerText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12"/>
                        <TextBlock Text="{Binding AiStatusText}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" FontSize="12"/>
                        <TextBlock Text="{Binding RadioNotice}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel>
                            <Button x:Name="BtnSend" Content="Send" Click="BtnSend_Click" DockPanel.Dock="Right" Style="{StaticResource TopButton}" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtMessage" KeyDown="TxtMessage_KeyDown" ToolTip="Type a CB message and press Enter (works without a microphone)"/>
                        </DockPanel>
                        <Button x:Name="BtnHoldPtt" Content="HOLD TO TALK (LEFT ALT)" Margin="0,8,0,0"
                                PreviewMouseLeftButtonDown="BtnHoldPtt_Down" PreviewMouseLeftButtonUp="BtnHoldPtt_Up"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource BgBrush}" FontWeight="Bold" Padding="16,10"/>
                    </StackPanel>
                    <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding RadioTranscriptLog}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
                </Grid>
        </TabItem>

        <!-- Career: company, levels, achievements, insights, per-truck MPG -->
        <TabItem Header="Career &amp; Company">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VIRTUAL COMPANY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CompanySummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Only trips recorded by TruckingAdvisor count. Income is the game's job income, not real money." Style="{StaticResource Label}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DRIVER CAREER" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CareerSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="INSIGHTS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Insights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="FUEL ECONOMY BY TRUCK" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding TruckEconomyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ACHIEVEMENTS &amp; COMPANY MILESTONES" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Achievements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="18"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource GoodBrush}">
                                                <Run Text="{Binding ProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- CB contacts (spec 40E) -->
        <TabItem Header="CB Contacts">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LstContacts" ItemsSource="{Binding Contacts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Handle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Style="{StaticResource Label}">
                                        <Run Text="{Binding Relationship, Mode=OneWay}"/><Run Text=" • last contact "/><Run Text="{Binding LastContact, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Conversations, Mode=OneWay}"/><Run Text=" conversations"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding SelectedItem, ElementName=LstContacts}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,2,0,8">
                            <Run Text="{Binding Truck, Mode=OneWay}"/><Run Text=" • from "/><Run Text="{Binding HomeState, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="WHAT THEY REMEMBER" Style="{StaticResource Label}"/>
                        <ItemsControl ItemsSource="{Binding Memories}" Margin="0,4,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Forget our conversations" Click="BtnForgetContact_Click" HorizontalAlignment="Left" Style="{StaticResource TopButton}"/>
                        <TextBlock Text="These are simulated radio characters, not real players or nearby trucks." Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Statistics: trends over recorded trips -->
        <TabItem Header="Statistics">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,6,10">
                        <c:TrendChart Title="Driver score (0-100)" Values="{Binding ScoreTrend}" Height="200" LineBrush="{DynamicResource GoodBrush}" TextBrush="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0,0,10">
                        <c:TrendChart Title="Fuel economy (MPG)" Values="{Binding MpgTrend}" Format="F1" Height="200" LineBrush="{DynamicResource AccentBrush}" TextBrush="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,6,10">
                        <c:TrendChart Title="Coaching events per 100 miles" Values="{Binding IncidentTrend}" Format="F1" Height="200" LineBrush="{DynamicResource BadBrush}" TextBrush="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0,0,10">
                        <c:TrendChart Title="Trip distance (miles)" Values="{Binding MilesTrend}" Height="200" LineBrush="{DynamicResource MutedBrush}" TextBrush="{DynamicResource MutedBrush}"/>
                    </Border>
                </UniformGrid>
            </ScrollViewer>
        </TabItem>

        <!-- Trip history and exports -->
        <TabItem Header="Trips">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Export all (CSV)" Click="BtnExportCsv_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Export selected (JSON)" Click="BtnExportJson_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Copy selected report" Click="BtnCopyReport_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Selected report (PDF)" Click="BtnExportPdf_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="All trips (PDF)" Click="BtnExportAllPdf_Click" Style="{StaticResource TopButton}"/>
                    <Button Content="Share image (PNG)" Click="BtnExportPng_Click" Style="{StaticResource TopButton}"/>
                </WrapPanel>
                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LstTrips" Grid.Row="1" ItemsSource="{Binding TripHistory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,3">
                                <Run Text="{Binding StartedAt, Mode=OneWay, StringFormat=yyyy-MM-dd}"/><Run Text="  "/><Run Text="{Binding Cargo, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Origin, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding Destination, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding DistanceMiles, Mode=OneWay, StringFormat={}{0:F0} mi}"/><Run Text="  •  score "/><Run Text="{Binding ScoreBreakdown.FinalScore, Mode=OneWay}" Foreground="{DynamicResource GoodBrush}"/><Run Text="  •  "/><Run Text="{Binding State, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
