<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The stream overlay page served to OBS by StreamOverlayServer. -->
    <EmbeddedResource Include="Streaming\overlay.html" LogicalName="TruckingAdvisor.AI.Streaming.overlay.html" />
    <!-- TruckingAdvisor's panel for the SimHub dashboard's web view. -->
    <EmbeddedResource Include="Streaming\simhub.html" LogicalName="TruckingAdvisor.AI.Streaming.simhub.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\TruckingAdvisor.Shared\TruckingAdvisor.Shared.csproj" />
  </ItemGroup>
</Project>
